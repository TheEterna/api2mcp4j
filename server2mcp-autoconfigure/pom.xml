<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ai.plug</groupId>
        <artifactId>server2mcp-parent</artifactId>
        <version>1.2.0</version>
    </parent>

    <name>server2mcp-autoconfigure</name>
    <description>
        server2mcp Spring Boot 自动配置模块 —— 按 plugin.mcp.* 配置装配 MCP Server 与解析器责任链。
    </description>

    <artifactId>server2mcp-autoconfigure</artifactId>
    <packaging>jar</packaging>

    <dependencies>


        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>


        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          只引基础 starter，不引任何 Web 栈 starter。
          原先引 spring-ai-starter-mcp-server-webmvc 会把 Servlet 栈拖进
          Reactive 用户 —— server2mcp-starter-webflux 因此被迫继承 MVC 传输层。
          Web 栈由各 starter 自行引入（webmvc → spring-ai-starter-mcp-server-webmvc，
          webflux → spring-ai-starter-mcp-server-webflux）。
          变更日：2026-10-27
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 内部依赖 -->
        <dependency>
            <groupId>com.ai.plug</groupId>
            <artifactId>server2mcp-core</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.ai.plug</groupId>
            <artifactId>server2mcp-common</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- 覆盖原始低稳定版本mcp -->

        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
            <version>${mcp-sdk.version}</version>
        </dependency>




    </dependencies>

</project>