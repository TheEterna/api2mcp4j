<?xml version="1.0" encoding="UTF-8"?>
<!--
  server2mcp · Maven Central 发布凭据模板

  用法：
    1. cp settings.xml.example ~/.m2/settings.xml
    2. 打开 https://central.sonatype.com/usertoken 点 "Generate User Token"，
       记下弹窗给出的【两段】值：username 与 password（关闭弹窗后无法找回）
    3. 分别设环境变量：
         export CENTRAL_PORTAL_USERNAME="<token username>"
         export CENTRAL_PORTAL_PASSWORD="<token password>"

  ⚠️ User Token 是两段独立值 —— 官方 settings.xml 片段把 token 的 username 填入
     <username>、password 填入 <password>。共用一个变量必然鉴权失败。
     来源：https://central.sonatype.org/publish/publish-portal-maven/

  ⚠️ 本文件是【模板】，仓库内绝不存放真实 token。
     生成物 ~/.m2/settings.xml 不在仓库范围内（由 .gitignore 的 credentials* / secrets* 规则及
     仓库外位置共同保证）。

  GPG 签名所需密钥不在此处配置 —— 由 gpg-agent / ~/.gnupg 持有，
  密钥公钥须上传至 keyserver.ubuntu.com / keys.openpgp.org / pgp.mit.edu 之一。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <servers>
        <!--
          <id>central</id> 必须与根 pom.xml 中
          central-publishing-maven-plugin 的 <publishingServerId>central</publishingServerId>
          严格一致。
        -->
        <server>
            <id>central</id>
            <username>${env.CENTRAL_PORTAL_USERNAME}</username>
            <password>${env.CENTRAL_PORTAL_PASSWORD}</password>
        </server>
    </servers>

    <!--
      可选：若使用 Maven 镜像加速，构建时保留此段；发布时中央仓库直连不受影响。
      <mirrors>
        <mirror>
          <id>central-mirror</id>
          <mirrorOf>central</mirrorOf>
          <url>https://repo1.maven.org/maven2</url>
        </mirror>
      </mirrors>
    -->
</settings>
